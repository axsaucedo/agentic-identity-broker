# Dockerfile for the ExtProc Token Exchange Service.
# Docker Compose builds the development stage from source. Release builds package
# the precompiled target-specific artifact.
ARG BASE_IMAGE=default
FROM container-registry.zalando.net/library/alpine-3:latest AS default

FROM --platform=$BUILDPLATFORM golang:1.26.8-alpine AS development-builder

ARG TARGETARCH

WORKDIR /app
ENV GOEXPERIMENT=jsonv2

RUN apk add --no-cache git ca-certificates

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH go build -ldflags="-s -w" \
    -o /tmp/extproc-token-exchange \
    ./cmd/extproc-token-exchange

FROM ${BASE_IMAGE} AS runtime

ARG VERSION

LABEL org.opencontainers.image.title="Agentic Identity Broker - ExtProc Token Exchange"
LABEL org.opencontainers.image.description="Envoy External Processing service for transparent Bearer token exchange"
LABEL org.opencontainers.image.version=$VERSION
LABEL org.opencontainers.image.vendor="Zalando SE"

RUN addgroup -g 1000 appuser && \
    adduser -D -u 1000 -G appuser appuser

WORKDIR /app

RUN apk add --no-cache ca-certificates

EXPOSE 50051

USER 1000:1000

CMD ["./extproc-token-exchange"]

FROM runtime AS development

COPY --chown=1000:1000 --from=development-builder /tmp/extproc-token-exchange /app/extproc-token-exchange

FROM runtime

ARG TARGETARCH

COPY --chown=1000:1000 ./bin/linux/${TARGETARCH}/extproc-token-exchange /app/extproc-token-exchange
