# Agentic Identity Broker - Production Environment Configuration
# Copy this file to .env.production for production deployments
# This file loads AFTER .env and can override its values

# Production Logging Configuration
IDENTITY_BROKER_LOG_LEVEL=warn
IDENTITY_BROKER_LOG_FORMAT=json

# Production YAML Configuration Path
IDENTITY_BROKER_CONFIG_PATH=/etc/identity-broker/config.yaml
