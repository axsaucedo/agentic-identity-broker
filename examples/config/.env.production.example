# Agentic Identity Broker - Production Environment Configuration
# Copy this file to .env.production for production deployments
# This file loads AFTER .env and can override its values

# Production Logging Configuration
IDENTITY_BROKER_LOG_LEVEL=warn
IDENTITY_BROKER_LOG_FORMAT=json

# Production YAML Configuration Path
IDENTITY_BROKER_CONFIG_PATH=/etc/identity-broker/config.yaml

# Production Encryption Configuration
# AWS KMS configuration via environment variables (recommended for production)
# These values override defaults in config.yaml
#
# Option 1: Load AWS KMS key ARN from environment (recommended)
# This allows rotating KMS keys without changing YAML configuration
# IDENTITY_BROKER_ENCRYPTION_KEY=arn:aws:kms:us-east-1:123456789012:key/12345678-1234-1234-1234-123456789012
#
# Option 2: Override DynamoDB table name and branch key TTL
# IDENTITY_BROKER_ENCRYPTION_DYNAMODB_TABLE_NAME=ProductionBranchKeys
# IDENTITY_BROKER_ENCRYPTION_BRANCH_KEY_TTL=4h
#
# AWS credentials for KMS and DynamoDB access:
# These are typically injected via IAM instance profile or AWS credential chain
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE (not recommended - use instance profile)
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY (not recommended - use instance profile)
