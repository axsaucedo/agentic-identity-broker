# Agentic Identity Broker - YAML Configuration Example
# Copy this file to config.yaml and customize for your deployment
# Supports environment variable substitution using ${VAR_NAME} syntax

# Logging Configuration
log:
  # Log level: debug, info, warn, error
  level: ${IDENTITY_BROKER_LOG_LEVEL}

  # Log format: text, json
  format: ${IDENTITY_BROKER_LOG_FORMAT}

# Future configuration sections will be added here:
# server:
#   host: ${IDENTITY_BROKER_SERVER_HOST}
#   port: ${IDENTITY_BROKER_SERVER_PORT}
