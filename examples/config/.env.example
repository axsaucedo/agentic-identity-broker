# Agentic Identity Broker - Environment Configuration Example
# Copy this file to .env and customize for your environment

# Logging Configuration
IDENTITY_BROKER_LOG_LEVEL=info
IDENTITY_BROKER_LOG_FORMAT=text

# Environment Configuration
# Determines which environment-specific .env files to load
# Options: development, staging, production
GO_ENV=development

# Optional: Path to YAML configuration file
# If not set, will look for config.yaml in current directory
# IDENTITY_BROKER_CONFIG_PATH=/etc/identity-broker/config.yaml
