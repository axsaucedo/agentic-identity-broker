# Agentic Identity Broker - Environment Configuration Example
# Copy this file to .env and customize for your environment

# Logging Configuration
IDENTITY_BROKER_LOG_LEVEL=info
IDENTITY_BROKER_LOG_FORMAT=text

# Environment Configuration
# Determines which environment-specific .env files to load
# Options: development, staging, production
GO_ENV=development

# Optional: Path to YAML configuration file
# If not set, will look for config.yaml in current directory
# IDENTITY_BROKER_CONFIG_PATH=/etc/agentic-identity-broker/config.yaml

# Encryption Configuration
# Choose one encryption approach:

# Option 1: AWS KMS with hierarchical keyring (production recommended)
# IDENTITY_BROKER_ENCRYPTION_KEY=arn:aws:kms:us-east-1:123456789012:key/12345678-1234-1234-1234-123456789012
# IDENTITY_BROKER_ENCRYPTION_DYNAMODB_TABLE_NAME=IdentityBrokerEncryptionBranchKeys  # Optional, defaults to IdentityBrokerEncryptionBranchKeys
# IDENTITY_BROKER_ENCRYPTION_BRANCH_KEY_TTL=1h                         # Optional, defaults to 1h

# Option 2: Environment variable KEK (development/testing)
# IDENTITY_BROKER_ENCRYPTION_KEY=${ENCRYPTION_KEK}
#
# Generate a secure 32-byte key with:
#   openssl rand -base64 32
#   python3 -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
#
# Then set:
#   export ENCRYPTION_KEK="base64-encoded-32-byte-key"
