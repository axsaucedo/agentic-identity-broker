FROM golang:1.26.8-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git ca-certificates

COPY mocks/cimd-server/go.mod ./
RUN go mod download

COPY mocks/cimd-server/ .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /tmp/cimd-server ./cmd/cimd-server

FROM alpine:latest

WORKDIR /app

RUN apk add --no-cache ca-certificates curl

COPY --from=builder /tmp/cimd-server .

CMD ["./cimd-server"]
